{
  "version": 2,
  "builds": [{ "src": "server.js", "use": "@vercel/node" }],
  "routes": [
    { "src": "/book", "dest": "/server.js" },
    { "src": "/bookings", "dest": "/server.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/style.css", "dest": "/style.css" },
    { "src": "/script.js", "dest": "/script.js" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" }
  ]
}
